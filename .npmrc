# expo-router declares optional peers for targets this app does not build —
# react-dom and Radix for web, reanimated and worklets for JS animations.
# npm's strict peer resolution picks mutually incompatible versions of them
# (react-dom wants a newer react than the SDK pins; reanimated and worklets
# disagree with each other), which fails `npm ci` even though nothing here
# imports any of it.
#
# This file, rather than a --legacy-peer-deps flag typed by hand, is what
# keeps EAS Build in step: its `npm ci` reads the same setting, so the lock
# file it installs from is the one generated locally.
legacy-peer-deps=true
